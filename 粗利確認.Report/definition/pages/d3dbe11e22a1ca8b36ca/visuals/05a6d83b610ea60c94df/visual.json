  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "【左の絞り込み欄（スライサー）】",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・クリックで選択、もう一度クリックで解除します。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・Ctrlキーを押しながらクリックすると、複数選べます。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・何も選ばないと、すべてが対象になります。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・売上日は、指定した日付までの売上が対象です。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "【表】",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・行をクリックすると、もう一方の表がその行に関係するものだけに絞り込まれます。もう一度クリックすると解除されます。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・列の見出しをクリックすると並べ替えます（もう一度で逆順）。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・利益率が低いほど、利益率の欄が赤くなります。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "【ほかのページに移ったとき】",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・絞り込み欄の選択は、同じ絞り込み欄があるほかのページにも引き継がれます。ほかのページで変えた選択も、このページに反映されます。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "・表の行をクリックした絞り込みは、このページの中だけです。",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#605E5C"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "background": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ]
    }
  }
