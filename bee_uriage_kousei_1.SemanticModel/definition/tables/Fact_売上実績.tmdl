	column 原価判明フラグ
		dataType: int64
		formatString: 0
		lineageTag: 0992ef77-effb-4e0d-ba31-0abf614bf67d
		summarizeBy: none
		sourceColumn: 原価判明フラグ

		annotation SummarizationSetBy = Automatic

	partition Fact_売上実績 = m
		mode: import
		source =
				let
				    SQL = "
				WITH items AS (
				  SELECT DISTINCT TRIM(F_在庫品目番号) AS 品目コード
				  FROM PRONES.TB_売上実績新情報
				  WHERE F_売上日 >= '2023/07/01' AND TRIM(F_在庫品目番号) NOT IN ('99999','N-99999')
				),
				months AS (
				  SELECT TO_CHAR(ADD_MONTHS(DATE '2017-01-01', LEVEL-1),'YYYY/MM') AS 年月
				  FROM DUAL CONNECT BY LEVEL <= 115
				),
				grid AS (
				  SELECT i.品目コード, m.年月 FROM items i CROSS JOIN months m
				),
				purchase_monthly AS (
				  SELECT TRIM(F_品目番号) AS 品目コード, F_勘定年月 AS 年月,
				         SUM(F_仕入数) AS 仕入数量, SUM(F_金額) AS 仕入金額
				  FROM PRONES.TB_仕入実績情報
				  WHERE TRIM(F_品目番号) NOT IN ('99999','N-99999')
				  GROUP BY TRIM(F_品目番号), F_勘定年月
				),
				cum AS (
				  SELECT 品目コード, 年月,
				    SUM(仕入数量) OVER (PARTITION BY 品目コード ORDER BY 年月) AS 累積数量,
				    SUM(仕入金額) OVER (PARTITION BY 品目コード ORDER BY 年月) AS 累積金額
				  FROM purchase_monthly
				),
				carry AS (
				  SELECT g.品目コード, g.年月,
				    LAST_VALUE(
				      CASE WHEN c.累積数量 IS NOT NULL AND c.累積数量<>0 THEN c.累積金額/c.累積数量 END
				      IGNORE NULLS
				    ) OVER (PARTITION BY g.品目コード ORDER BY g.年月) AS 有効仕入単価
				  FROM grid g
				  LEFT JOIN cum c ON c.品目コード = g.品目コード AND c.年月 = g.年月
				)
				SELECT
				  TRIM(s.F_得意先番号) AS 得意先番号,
				  TRIM(s.F_在庫品目番号) AS 品目コード,
				  SUBSTR(s.F_売上日,1,7) AS 年月,
				  SUM(s.F_数量) AS 数量,
				  SUM(s.F_金額) AS 金額,
				  MAX(ca.有効仕入単価) AS 有効仕入単価,
				  ROUND(SUM(s.F_数量) * MAX(ca.有効仕入単価)) AS 仕入原価推定,
				  CASE WHEN MAX(ca.有効仕入単価) IS NOT NULL THEN 1 ELSE 0 END AS 原価判明フラグ
				FROM PRONES.TB_売上実績新情報 s
				LEFT JOIN carry ca ON ca.品目コード = TRIM(s.F_在庫品目番号) AND ca.年月 = SUBSTR(s.F_売上日,1,7)
				WHERE s.F_売上日 >= '2023/07/01' AND TRIM(s.F_在庫品目番号) NOT IN ('99999','N-99999')
				GROUP BY TRIM(s.F_得意先番号), TRIM(s.F_在庫品目番号), SUBSTR(s.F_売上日,1,7)
				",
				    Source = Value.NativeQuery(
				        Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"),
				        SQL
				    )
				in
				    Source

	annotation PBI_ResultType = Table

