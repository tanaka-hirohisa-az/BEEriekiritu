table Fact_売上実績
	lineageTag: 3fa4ad82-9ba5-4597-88eb-64b2ae08c26a

	measure 売上高 = SUM(Fact_売上実績[金額])
		formatString: #,##0
		lineageTag: 6522abcf-36e7-4f08-a23f-e87dcb27e19b

	measure 原価判明売上高 = CALCULATE(SUM(Fact_売上実績[金額]), Fact_売上実績[原価判明フラグ] = 1)
		formatString: #,##0
		lineageTag: e0698b7f-9c7e-4e89-9ab4-65e1a709e31a

	measure 仕入原価 = CALCULATE(SUM(Fact_売上実績[仕入原価推定]), Fact_売上実績[原価判明フラグ] = 1)
		formatString: #,##0
		lineageTag: 30daab75-ed9b-497e-8a70-0aca3e1e1686

	measure 利益 = [原価判明売上高] - [仕入原価]
		formatString: #,##0
		lineageTag: f4644ef4-a60e-4bc0-947a-9f05db248350

	measure 利益率 = DIVIDE([利益], [原価判明売上高])
		formatString: 0.0%
		lineageTag: 5d0a58bb-599c-44aa-9740-184de2962662

	measure 原価カバー率 = DIVIDE([原価判明売上高], [売上高])
		formatString: 0.0%
		lineageTag: c7a76331-940b-4a03-96c2-d4df385e169c

