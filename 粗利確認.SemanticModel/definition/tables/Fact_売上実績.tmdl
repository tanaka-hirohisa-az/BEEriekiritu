		lineageTag: 3c9b0fce-1404-479d-a536-0c84089c3502

	measure 概算利益率 = DIVIDE([概算利益], [売上高])
		formatString: 0.0%
		lineageTag: 09859d42-330c-4520-9bd4-febbdffcce77

	measure 売上高_年計 =
			VAR SelectedYear = SELECTEDVALUE('Dim_カレンダー'[年])
			VAR SelectedMonth = SELECTEDVALUE('Dim_カレンダー'[月])
			RETURN
			CALCULATE([売上高], FILTER(ALL('Dim_カレンダー'), 'Dim_カレンダー'[年] = SelectedYear && 'Dim_カレンダー'[月] <= SelectedMonth))
		formatString: #,##0
		lineageTag: f7258e5b-e598-454d-802e-2c963bac9869

	measure 概算利益_年計 =
			VAR SelectedYear = SELECTEDVALUE('Dim_カレンダー'[年])
			VAR SelectedMonth = SELECTEDVALUE('Dim_カレンダー'[月])
			RETURN
			CALCULATE([概算利益], FILTER(ALL('Dim_カレンダー'), 'Dim_カレンダー'[年] = SelectedYear && 'Dim_カレンダー'[月] <= SelectedMonth))
		formatString: #,##0
		lineageTag: ed9b4d85-bf85-4dab-92ee-e00368c59dd0

	measure 概算利益率_年計 = DIVIDE([概算利益_年計], [売上高_年計])
		formatString: 0.0%
		lineageTag: 90b06a0f-e7fa-4675-82b9-ea7490879184

	measure 概算利益率_前年同月 =
			VAR SelectedYear = SELECTEDVALUE('Dim_カレンダー'[年])
			VAR SelectedMonth = SELECTEDVALUE('Dim_カレンダー'[月])
			RETURN
			CALCULATE([概算利益率], FILTER(ALL('Dim_カレンダー'), 'Dim_カレンダー'[年] = SelectedYear - 1 && 'Dim_カレンダー'[月] = SelectedMonth))
		formatString: 0.0%
		lineageTag: 52247132-60be-4c97-99b7-72e799239723

	measure 概算利益率_前年通期 =
			VAR SelectedYear = SELECTEDVALUE('Dim_カレンダー'[年])
			RETURN
			CALCULATE([概算利益率], FILTER(ALL('Dim_カレンダー'), 'Dim_カレンダー'[年] = SelectedYear - 1))
		formatString: 0.0%
		lineageTag: c5e0b09e-e917-49e7-9c26-5272c70466b9

	measure 概算利益率_変動幅 =
			VAR StartDate = CALCULATE(FIRSTNONBLANK('Dim_カレンダー'[月初日], [概算利益率]), ALL('Dim_カレンダー'[年月表示]))
			VAR EndDate = CALCULATE(LASTNONBLANK('Dim_カレンダー'[月初日], [概算利益率]), ALL('Dim_カレンダー'[年月表示]))
			VAR StartValue = CALCULATE([概算利益率], ALL('Dim_カレンダー'[年月表示]), 'Dim_カレンダー'[月初日] = StartDate)
			VAR EndValue = CALCULATE([概算利益率], ALL('Dim_カレンダー'[年月表示]), 'Dim_カレンダー'[月初日] = EndDate)
			RETURN
			EndValue - StartValue
		formatString: 0.0%
		lineageTag: 1a2b3c4d-5e6f-4708-9a0b-1c2d3e4f5061

	measure 概算利益率_変動幅絶対値 = ABS([概算利益率_変動幅])
