table Fact_売上実績
	lineageTag: 3fa4ad82-9ba5-4597-88eb-64b2ae08c26a

	measure 売上高 = SUM('Fact_売上実績'[金額])
		formatString: #,##0
		lineageTag: 6522abcf-36e7-4f08-a23f-e87dcb27e19b

	measure 仕入単価あり売上高 = CALCULATE(SUM('Fact_売上実績'[金額]), 'Fact_売上実績'[仕入単価有無] = "あり")
		formatString: #,##0
		lineageTag: f5035337-a010-4031-9cc3-035d9d2e8d90

	measure 仕入原価 = CALCULATE(SUM('Fact_売上実績'[仕入原価推定]), 'Fact_売上実績'[仕入単価有無] = "あり")
		formatString: #,##0
		lineageTag: ed855eff-e438-4aa4-ba42-a8152c5f4d4d

	measure 利益 = [仕入単価あり売上高] - [仕入原価]
		formatString: #,##0
		lineageTag: a9637b56-ffae-4918-9ed2-f18f71c6ec30

	measure 利益率 = DIVIDE([利益], [仕入単価あり売上高])
		formatString: 0.0%
		lineageTag: a7e068fc-95ce-402b-86a4-f59872a2c86b

	measure 仕入単価取得率 = DIVIDE([仕入単価あり売上高], [売上高])
		formatString: 0.000%
		lineageTag: a9bfb256-b512-495c-ad63-18bb1e4ffb74

	measure 仕入契約単価あり売上高 = CALCULATE(SUM('Fact_売上実績'[金額]), 'Fact_売上実績'[仕入契約単価有無] = "あり")
		formatString: #,##0
		lineageTag: f464d093-a7cb-4262-a3ee-62852bdf4c1e

	measure 契約仕入原価 = CALCULATE(SUM('Fact_売上実績'[契約仕入原価推定]), 'Fact_売上実績'[仕入契約単価有無] = "あり")
		formatString: #,##0
		lineageTag: 2066f8e2-8f50-40a3-8e9d-4bcc087749b8

	measure 契約利益 = [仕入契約単価あり売上高] - [契約仕入原価]
