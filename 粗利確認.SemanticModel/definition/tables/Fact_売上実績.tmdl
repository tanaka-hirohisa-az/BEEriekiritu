	column 売単価 = DIVIDE('Fact_売上実績'[金額], 'Fact_売上実績'[数量])
		dataType: double
		formatString: #,##0.00
		lineageTag: 6f3a1c8e-2b47-4d9a-8e5c-1a9f6d3b2c7e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fact_売上実績 = m
		mode: import
		source =
				let
				    Raw = Value.NativeQuery(Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"), "SELECT * FROM ( WITH items AS (SELECT DISTINCT TRIM(F_在庫品目番号) AS 品目コード FROM PRONES.TB_売上実績新情報 WHERE F_売上日 >= '2023/07/01'), months AS (SELECT TO_CHAR(ADD_MONTHS(DATE '2017-01-01', LEVEL-1),'YYYY/MM') AS 年月, ADD_MONTHS(DATE '2017-01-01', LEVEL-1) AS 年月日付 FROM DUAL CONNECT BY LEVEL <= 115), grid AS (SELECT i.品目コード, m.年月, m.年月日付 FROM items i CROSS JOIN months m), purchase_monthly AS (SELECT TRIM(F_品目番号) AS 品目コード, F_勘定年月 AS 年月, TO_DATE(F_勘定年月,'YYYY/MM') AS 年月日付, SUM(F_仕入数) AS 仕入数量, SUM(F_金額) AS 仕入金額, CASE WHEN SUM(F_仕入数)<>0 THEN SUM(F_金額)/SUM(F_仕入数) END AS 単月単価, MAX(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS 単月内最高単価, MIN(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS 単月内最安単価, AVG(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS 単月内単純平均単価 FROM PRONES.TB_仕入実績情報 GROUP BY TRIM(F_品目番号), F_勘定年月), windowed AS (SELECT g.品目コード, g.年月, CASE WHEN SUM(pm.仕入数量) IS NOT NULL AND SUM(pm.仕入数量)<>0 THEN SUM(pm.仕入金額)/SUM(pm.仕入数量) END AS 有効仕入単価_6mo, MAX(pm.単月単価) AS 窓内最高単価, MIN(pm.単月単価) AS 窓内最安単価 FROM grid g LEFT JOIN purchase_monthly pm ON pm.品目コード = g.品目コード AND pm.年月日付 BETWEEN ADD_MONTHS(g.年月日付,-5) AND g.年月日付 GROUP BY g.品目コード, g.年月), carried AS (SELECT g.品目コード, g.年月, LAST_VALUE(pm.単月単価 IGNORE NULLS) OVER (PARTITION BY g.品目コード ORDER BY g.年月日付) AS 有効仕入単価_carry, LAST_VALUE(CASE WHEN pm.単月単価 IS NOT NULL THEN pm.年月 END IGNORE NULLS) OVER (PARTITION BY g.品目コード ORDER BY g.年月日付) AS 単月仕入年月, LAST_VALUE(pm.単月内最高単価 IGNORE NULLS) OVER (PARTITION BY g.品目コード ORDER BY g.年月日付) AS 単月最高単価, LAST_VALUE(pm.単月内最安単価 IGNORE NULLS) OVER (PARTITION BY g.品目コード ORDER BY g.年月日付) AS 単月最安単価, LAST_VALUE(pm.単月内単純平均単価 IGNORE NULLS) OVER (PARTITION BY g.品目コード ORDER BY g.年月日付) AS 単月平均単価 FROM grid g LEFT JOIN purchase_monthly pm ON pm.品目コード = g.品目コード AND pm.年月日付 = g.年月日付), purchase_by_supplier AS (SELECT TRIM(F_品目番号) AS 品目コード, F_勘定年月 AS 年月, TO_DATE(F_勘定年月,'YYYY/MM') AS 年月日付, TRIM(F_指示先番号) AS 仕入先番号, SUM(F_金額) AS 金額 FROM PRONES.TB_仕入実績情報 GROUP BY TRIM(F_品目番号), F_勘定年月, TRIM(F_指示先番号)), supplier_name AS (SELECT TRIM(F_仕入先番号) AS 仕入先番号, MAX(F_仕入先略称) AS 仕入先略称 FROM PRONES.TB_仕入先情報 GROUP BY TRIM(F_仕入先番号)), windowed_sup AS (SELECT g.品目コード, g.年月, COUNT(DISTINCT pbs.仕入先番号) AS 件数, MAX(pbs.仕入先番号) AS 単一仕入先 FROM grid g LEFT JOIN purchase_by_supplier pbs ON pbs.品目コード = g.品目コード AND pbs.年月日付 BETWEEN ADD_MONTHS(g.年月日付,-5) AND g.年月日付 GROUP BY g.品目コード, g.年月), carried_sup AS (SELECT c.品目コード, c.年月, COUNT(DISTINCT pbs.仕入先番号) AS 件数, MAX(pbs.仕入先番号) AS 単一仕入先 FROM carried c LEFT JOIN purchase_by_supplier pbs ON pbs.品目コード = c.品目コード AND pbs.年月 = c.単月仕入年月 GROUP BY c.品目コード, c.年月), final_price AS (SELECT w.品目コード, w.年月, COALESCE(w.有効仕入単価_6mo, c.有効仕入単価_carry) AS 有効仕入単価, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN w.年月 ELSE c.単月仕入年月 END AS 仕入年月, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN w.窓内最高単価 ELSE c.単月最高単価 END AS 最高単価, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN w.窓内最安単価 ELSE c.単月最安単価 END AS 最安単価, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN w.有効仕入単価_6mo ELSE c.単月平均単価 END AS 平均単価, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN '6ヶ月平均' WHEN c.有効仕入単価_carry IS NOT NULL THEN '単月' END AS 採用方式, CASE WHEN w.有効仕入単価_6mo IS NOT NULL THEN CASE WHEN ws.件数 = 1 THEN snw.仕入先略称 WHEN ws.件数 > 1 THEN '*' END ELSE CASE WHEN cs.件数 = 1 THEN snc.仕入先略称 WHEN cs.件数 > 1 THEN '*' END END AS 仕入略称 FROM windowed w JOIN carried c ON c.品目コード = w.品目コード AND c.年月 = w.年月 LEFT JOIN windowed_sup ws ON ws.品目コード = w.品目コード AND ws.年月 = w.年月 LEFT JOIN carried_sup cs ON cs.品目コード = w.品目コード AND cs.年月 = w.年月 LEFT JOIN supplier_name snw ON snw.仕入先番号 = ws.単一仕入先 LEFT JOIN supplier_name snc ON snc.仕入先番号 = cs.単一仕入先), sale_days AS (SELECT DISTINCT TRIM(F_在庫品目番号) AS 品目コード, F_売上日 FROM PRONES.TB_売上実績新情報 WHERE F_売上日 >= '2023/07/01'), item_designated_supplier AS (SELECT TRIM(F_納入品目番号) AS 品目コード, MAX(TRIM(F_指示先番号)) AS 指示先 FROM PRONES.TB_納入品目情報 GROUP BY TRIM(F_納入品目番号)), contract_price AS (SELECT TRIM(F_納入品目番号) AS 品目コード, TRIM(F_仕入先番号) AS 仕入先, F_契約単価, CASE WHEN TRANSLATE(F_開始日,'0123456789','9999999999') = '9999/99/99' THEN TO_DATE(F_開始日,'YYYY/MM/DD') END AS 開始日付 FROM PRONES.TB_納入品目仕入先単価情報 WHERE F_契約単価 > 0), contract_ranked AS (SELECT sd.品目コード, sd.F_売上日, cp.F_契約単価, cp.開始日付, ROW_NUMBER() OVER (PARTITION BY sd.品目コード, sd.F_売上日 ORDER BY CASE WHEN cp.仕入先 = ids.指示先 THEN 0 ELSE 1 END, cp.開始日付 DESC) AS rn FROM sale_days sd LEFT JOIN item_designated_supplier ids ON ids.品目コード = sd.品目コード JOIN contract_price cp ON cp.品目コード = sd.品目コード AND cp.開始日付 IS NOT NULL AND cp.開始日付 <= TO_DATE(sd.F_売上日,'YYYY/MM/DD')), contract_effective AS (SELECT 品目コード, F_売上日, F_契約単価 AS 仕入契約単価, 開始日付 FROM contract_ranked WHERE rn = 1), contract_price_2000001 AS (SELECT TRIM(F_納入品目番号) AS 品目コード, TRIM(F_仕入先番号) AS 仕入先, F_契約単価, CASE WHEN TRANSLATE(F_開始日,'0123456789','9999999999') = '9999/99/99' THEN TO_DATE(F_開始日,'YYYY/MM/DD') END AS 開始日付 FROM PRONES.TB_納入品目仕入先単価情報 WHERE F_契約単価 > 0), contract_ranked_2000001 AS (SELECT sd.品目コード, sd.F_売上日, cp.F_契約単価, cp.開始日付, ROW_NUMBER() OVER (PARTITION BY sd.品目コード, sd.F_売上日 ORDER BY CASE WHEN cp.仕入先 = ids.指示先 THEN 0 ELSE 1 END, cp.開始日付 DESC) AS rn FROM sale_days sd LEFT JOIN item_designated_supplier ids ON ids.品目コード = sd.品目コード JOIN contract_price_2000001 cp ON cp.品目コード = sd.品目コード AND cp.開始日付 IS NOT NULL AND cp.開始日付 <= TO_DATE(sd.F_売上日,'YYYY/MM/DD')), contract_effective_2000001 AS (SELECT 品目コード, F_売上日, F_契約単価 AS 仕入契約単価2000001, 開始日付 FROM contract_ranked_2000001 WHERE rn = 1), primary_supplier AS (SELECT 品目コード, 仕入先番号 FROM (SELECT TRIM(F_品目番号) AS 品目コード, TRIM(F_指示先番号) AS 仕入先番号, SUM(F_金額) AS 金額, ROW_NUMBER() OVER (PARTITION BY TRIM(F_品目番号) ORDER BY SUM(F_金額) DESC) AS rn FROM PRONES.TB_仕入実績情報 WHERE F_勘定年月 >= '2017/01' GROUP BY TRIM(F_品目番号), TRIM(F_指示先番号)) WHERE rn = 1) SELECT TRIM(s.F_得意先番号) AS 得意先番号, MAX(TRIM(s.F_得意先番号) || (chr(35)) || TO_CHAR(ORA_HASH(TRIM(s.F_得意先番号)))) AS 得意先キー, TRIM(s.F_在庫品目番号) AS 品目コード, SUBSTR(s.F_売上日,1,7) AS 年月, TO_DATE(s.F_売上日,'YYYY/MM/DD') AS 売上日, SUM(s.F_数量) AS 数量, SUM(s.F_金額) AS 金額, MAX(fp.有効仕入単価) AS 仕入単価, ROUND(SUM(s.F_数量) * MAX(fp.有効仕入単価)) AS 仕入原価推定, CASE WHEN MAX(fp.有効仕入単価) IS NOT NULL THEN 'あり' ELSE 'なし' END AS 仕入単価有無, MAX(fp.仕入年月) AS 仕入年月, MAX(fp.仕入略称) AS 仕入先略称, MAX(fp.採用方式) AS 採用方式, MAX(fp.最高単価) AS 最高単価, MAX(fp.最安単価) AS 最安単価, MAX(fp.平均単価) AS 平均単価, MAX(ce.仕入契約単価) AS 仕入契約単価, MAX(ce.開始日付) AS 仕入契約単価取得日, ROUND(SUM(s.F_数量) * MAX(ce.仕入契約単価)) AS 契約仕入原価推定, CASE WHEN MAX(ce.仕入契約単価) IS NOT NULL THEN 'あり' ELSE 'なし' END AS 仕入契約単価有無, CASE WHEN MAX(ps.仕入先番号) IS NULL THEN '仕入実績なし' WHEN MAX(ps.仕入先番号) IN ('2000001','2000002','2000004','2000005','2000006','2000007') THEN 'BEI' ELSE 'その他' END AS 仕入先区分, MAX(ce2.仕入契約単価2000001) AS 取得仕入契約単価, MAX(ce2.開始日付) AS 仕入単価取得日, CASE WHEN MAX(ce2.仕入契約単価2000001) IS NOT NULL THEN ROUND(SUM(s.F_数量) * MAX(ce2.仕入契約単価2000001)) ELSE ROUND(SUM(s.F_金額) * 0.85) END AS 概算仕入原価推定, CASE WHEN MAX(ce2.仕入契約単価2000001) IS NOT NULL THEN '仕入契約単価' ELSE '売上高×85%' END AS 概算原価算出方式, MAX(s.F_登録日) AS 最新登録日 FROM PRONES.TB_売上実績新情報 s LEFT JOIN final_price fp ON fp.品目コード = TRIM(s.F_在庫品目番号) AND fp.年月 = SUBSTR(s.F_売上日,1,7) LEFT JOIN contract_effective ce ON ce.品目コード = TRIM(s.F_在庫品目番号) AND ce.F_売上日 = s.F_売上日 LEFT JOIN contract_effective_2000001 ce2 ON ce2.品目コード = TRIM(s.F_在庫品目番号) AND ce2.F_売上日 = s.F_売上日 LEFT JOIN primary_supplier ps ON ps.品目コード = TRIM(s.F_在庫品目番号) WHERE s.F_売上日 >= '2023/07/01' GROUP BY TRIM(s.F_得意先番号), TRIM(s.F_在庫品目番号), s.F_売上日 ) q"),
				    Source = Table.TransformColumnTypes(Raw, {{"仕入単価有無", type text}, {"売上日", type date}, {"数量", type number}, {"金額", type number}, {"仕入単価", type number}, {"仕入原価推定", type number}, {"仕入年月", type text}, {"仕入先略称", type text}, {"採用方式", type text}, {"最高単価", type number}, {"最安単価", type number}, {"平均単価", type number}, {"仕入契約単価", type number}, {"仕入契約単価取得日", type date}, {"契約仕入原価推定", type number}, {"仕入契約単価有無", type text}, {"仕入先区分", type text}, {"取得仕入契約単価", type number}, {"仕入単価取得日", type date}, {"概算仕入原価推定", type number}, {"概算原価算出方式", type text}, {"最新登録日", type datetime}})
				in
				    Source

	annotation PBI_ResultType = Table

