table Dim_Part
	lineageTag: 0b5b7c6f-b2c9-430a-b01f-4232c3766c93

	column Part_Code
		dataType: string
		lineageTag: d456bf75-59a6-4892-bc6b-abf246d41701
		summarizeBy: none
		sourceColumn: PART_CODE

		annotation SummarizationSetBy = Automatic

	column Part_Name
		dataType: string
		lineageTag: 712bb5e2-0ea2-4743-9b6e-8be55380b1e6
		summarizeBy: none
		sourceColumn: PART_NAME

		annotation SummarizationSetBy = Automatic

	column Part_Category
		dataType: string
		lineageTag: 31e233f8-3dd5-4e9c-b310-7c0c9b98829f
		summarizeBy: none
		sourceColumn: PART_CATEGORY

		annotation SummarizationSetBy = Automatic

	partition Dim_Part = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"), "SELECT * FROM ( WITH sold_items AS (SELECT DISTINCT TRIM(F_在庫品目番号) AS Part_Code FROM PRONES.TB_売上実績新情報 WHERE F_売上日 >= '2023/07/01') SELECT si.Part_Code, NVL(MAX(i.F_品目名称), si.Part_Code) AS Part_Name, CASE WHEN si.Part_Code = '99999' THEN 'Unregistered (99999)' ELSE NVL(MAX(c.F_分類名), 'Other/Uncoded') END AS Part_Category FROM sold_items si LEFT JOIN PRONES.TB_納入品目情報 i ON TRIM(i.F_在庫用品目番号) = si.Part_Code LEFT JOIN PRONES.TB_品目分類情報 c ON TRIM(c.F_番号) = TRIM(i.F_品目分類) GROUP BY si.Part_Code ) q")
				in
				    Source

	annotation PBI_ResultType = Table

