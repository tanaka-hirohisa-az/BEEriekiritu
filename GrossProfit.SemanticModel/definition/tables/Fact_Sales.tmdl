table Fact_Sales
	lineageTag: 3fa4ad82-9ba5-4597-88eb-64b2ae08c26a

	measure Sales = SUM('Fact_Sales'[Amount])
		formatString: #,##0
		lineageTag: 6522abcf-36e7-4f08-a23f-e87dcb27e19b

	measure Sales_with_Actual_Price = CALCULATE(SUM('Fact_Sales'[Amount]), 'Fact_Sales'[Purchase_Price_Found] = "Yes")
		formatString: #,##0
		lineageTag: f5035337-a010-4031-9cc3-035d9d2e8d90

	measure Actual_Cost = CALCULATE(SUM('Fact_Sales'[Est_Actual_Cost]), 'Fact_Sales'[Purchase_Price_Found] = "Yes")
		formatString: #,##0
		lineageTag: ed855eff-e438-4aa4-ba42-a8152c5f4d4d

	measure Actual_Profit = [Sales_with_Actual_Price] - [Actual_Cost]
		formatString: #,##0
		lineageTag: a9637b56-ffae-4918-9ed2-f18f71c6ec30

	measure Actual_Profit_Rate = DIVIDE([Actual_Profit], [Sales_with_Actual_Price])
		formatString: 0.0%
		lineageTag: a7e068fc-95ce-402b-86a4-f59872a2c86b

	measure Actual_Price_Coverage = DIVIDE([Sales_with_Actual_Price], [Sales])
		formatString: 0.000%
		lineageTag: a9bfb256-b512-495c-ad63-18bb1e4ffb74

	measure Sales_with_Contract_Price = CALCULATE(SUM('Fact_Sales'[Amount]), 'Fact_Sales'[Contract_Price_Found] = "Yes")
		formatString: #,##0
		lineageTag: f464d093-a7cb-4262-a3ee-62852bdf4c1e

	measure Contract_Cost = CALCULATE(SUM('Fact_Sales'[Est_Contract_Cost]), 'Fact_Sales'[Contract_Price_Found] = "Yes")
		formatString: #,##0
		lineageTag: 2066f8e2-8f50-40a3-8e9d-4bcc087749b8

	measure Contract_Profit = [Sales_with_Contract_Price] - [Contract_Cost]
		formatString: #,##0
		lineageTag: 940c6725-2842-4f15-a817-3e23cff30412

	measure Contract_Profit_Rate = DIVIDE([Contract_Profit], [Sales_with_Contract_Price])
		formatString: 0.0%
		lineageTag: 06ee039d-8537-4325-81a4-17b8d9a77be1

	measure Contract_Price_Coverage = DIVIDE([Sales_with_Contract_Price], [Sales])
		formatString: 0.000%
		lineageTag: 3ff1e1b3-907a-43cd-98ef-4b625a4d488b

	measure Approx_Cost = SUM('Fact_Sales'[Est_Approx_Cost])
		formatString: #,##0
		lineageTag: 942e4dba-46f8-49e9-97f7-bf5d96e26ad3

	measure Approx_Profit = [Sales] - [Approx_Cost]
		formatString: #,##0
		lineageTag: 3c9b0fce-1404-479d-a536-0c84089c3502

	measure Approx_Profit_Rate = DIVIDE([Approx_Profit], [Sales])
		formatString: 0.0%
		lineageTag: 09859d42-330c-4520-9bd4-febbdffcce77

	measure Sales_YTD =
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR SelectedMonth = SELECTEDVALUE('Dim_Calendar'[Month])
			RETURN
			CALCULATE([Sales], FILTER(ALL('Dim_Calendar'), 'Dim_Calendar'[Year] = SelectedYear && 'Dim_Calendar'[Month] <= SelectedMonth))
		formatString: #,##0
		lineageTag: f7258e5b-e598-454d-802e-2c963bac9869

	measure Approx_Profit_YTD =
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR SelectedMonth = SELECTEDVALUE('Dim_Calendar'[Month])
			RETURN
			CALCULATE([Approx_Profit], FILTER(ALL('Dim_Calendar'), 'Dim_Calendar'[Year] = SelectedYear && 'Dim_Calendar'[Month] <= SelectedMonth))
		formatString: #,##0
		lineageTag: ed9b4d85-bf85-4dab-92ee-e00368c59dd0

	measure Approx_Profit_Rate_YTD = DIVIDE([Approx_Profit_YTD], [Sales_YTD])
		formatString: 0.0%
		lineageTag: 90b06a0f-e7fa-4675-82b9-ea7490879184

	measure Approx_Profit_Rate_PY_Same_Month =
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			VAR SelectedMonth = SELECTEDVALUE('Dim_Calendar'[Month])
			RETURN
			CALCULATE([Approx_Profit_Rate], FILTER(ALL('Dim_Calendar'), 'Dim_Calendar'[Year] = SelectedYear - 1 && 'Dim_Calendar'[Month] = SelectedMonth))
		formatString: 0.0%
		lineageTag: 52247132-60be-4c97-99b7-72e799239723

	measure Approx_Profit_Rate_PY_Full_Year =
			VAR SelectedYear = SELECTEDVALUE('Dim_Calendar'[Year])
			RETURN
			CALCULATE([Approx_Profit_Rate], FILTER(ALL('Dim_Calendar'), 'Dim_Calendar'[Year] = SelectedYear - 1))
		formatString: 0.0%
		lineageTag: c5e0b09e-e917-49e7-9c26-5272c70466b9

	measure Approx_Profit_Rate_Change =
			VAR StartDate = CALCULATE(FIRSTNONBLANK('Dim_Calendar'[Month_Start], [Approx_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR EndDate = CALCULATE(LASTNONBLANK('Dim_Calendar'[Month_Start], [Approx_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR StartValue = CALCULATE([Approx_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = StartDate)
			VAR EndValue = CALCULATE([Approx_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = EndDate)
			RETURN
			EndValue - StartValue
		formatString: 0.0%
		lineageTag: 1a2b3c4d-5e6f-4708-9a0b-1c2d3e4f5061

	measure Approx_Profit_Rate_Change_Abs = ABS([Approx_Profit_Rate_Change])
		formatString: 0.0%
		lineageTag: b425d6e7-f809-4708-9405-162738495061

	measure Approx_Profit_Rate_Change_Rank = RANKX(ALL('Dim_Part'[Part_Code]), [Approx_Profit_Rate_Change_Abs])
		formatString: 0
		lineageTag: 2b3c4d5e-6f70-4819-0b1c-2d3e4f506172

	measure Actual_Profit_Rate_Change =
			VAR StartDate = CALCULATE(FIRSTNONBLANK('Dim_Calendar'[Month_Start], [Actual_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR EndDate = CALCULATE(LASTNONBLANK('Dim_Calendar'[Month_Start], [Actual_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR StartValue = CALCULATE([Actual_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = StartDate)
			VAR EndValue = CALCULATE([Actual_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = EndDate)
			RETURN
			EndValue - StartValue
		formatString: 0.0%
		lineageTag: 3c4d5e6f-7081-4920-1c2d-3e4f50617283

	measure Actual_Profit_Rate_Change_Abs = ABS([Actual_Profit_Rate_Change])
		formatString: 0.0%
		lineageTag: c536e7f8-091a-4819-0516-273849506172

	measure Actual_Profit_Rate_Change_Rank = RANKX(ALL('Dim_Part'[Part_Code]), [Actual_Profit_Rate_Change_Abs])
		formatString: 0
		lineageTag: 4d5e6f70-8192-4031-2d3e-4f5061728394

	measure Contract_Profit_Rate_Change =
			VAR StartDate = CALCULATE(FIRSTNONBLANK('Dim_Calendar'[Month_Start], [Contract_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR EndDate = CALCULATE(LASTNONBLANK('Dim_Calendar'[Month_Start], [Contract_Profit_Rate]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR StartValue = CALCULATE([Contract_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = StartDate)
			VAR EndValue = CALCULATE([Contract_Profit_Rate], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = EndDate)
			RETURN
			EndValue - StartValue
		formatString: 0.0%
		lineageTag: 5e6f7081-92a3-4142-3e4f-506172839405

	measure Contract_Profit_Rate_Change_Abs = ABS([Contract_Profit_Rate_Change])
		formatString: 0.0%
		lineageTag: d647f809-1a2b-4930-6273-849506172839

	measure Contract_Profit_Rate_Change_Rank = RANKX(ALL('Dim_Part'[Part_Code]), [Contract_Profit_Rate_Change_Abs])
		formatString: 0
		lineageTag: 6f708192-a3b4-4253-4f50-617283940516

	measure Sales_Change =
			VAR StartDate = CALCULATE(FIRSTNONBLANK('Dim_Calendar'[Month_Start], [Sales]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR EndDate = CALCULATE(LASTNONBLANK('Dim_Calendar'[Month_Start], [Sales]), ALL('Dim_Calendar'[Year_Month_Label]))
			VAR StartValue = CALCULATE([Sales], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = StartDate)
			VAR EndValue = CALCULATE([Sales], ALL('Dim_Calendar'[Year_Month_Label]), 'Dim_Calendar'[Month_Start] = EndDate)
			RETURN
			EndValue - StartValue
		formatString: #,##0
		lineageTag: 708192a3-b4c5-4364-5061-728394051627

	measure Sales_Change_Abs = ABS([Sales_Change])
		formatString: #,##0
		lineageTag: e758f901-2b3c-4041-7384-950617283940

	measure Sales_Change_Rank = RANKX(ALL('Dim_Part'[Part_Code]), [Sales_Change_Abs])
		formatString: 0
		lineageTag: 8192a3b4-c5d6-4475-6172-839405162738

