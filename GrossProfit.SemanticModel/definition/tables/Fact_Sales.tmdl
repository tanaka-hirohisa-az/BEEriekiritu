	column Sales_Unit_Price = DIVIDE('Fact_Sales'[Amount], 'Fact_Sales'[Qty])
		dataType: double
		formatString: #,##0.00
		lineageTag: 6f3a1c8e-2b47-4d9a-8e5c-1a9f6d3b2c7e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fact_Sales = m
		mode: import
		source =
				let
				    Raw = Value.NativeQuery(Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"), "SELECT * FROM ( WITH items AS (SELECT DISTINCT TRIM(F_在庫品目番号) AS Part_Code FROM PRONES.TB_売上実績新情報 WHERE F_売上日 >= '2023/07/01'), months AS (SELECT TO_CHAR(ADD_MONTHS(DATE '2017-01-01', LEVEL-1),'YYYY/MM') AS Year_Month, ADD_MONTHS(DATE '2017-01-01', LEVEL-1) AS Year_Month_Date FROM DUAL CONNECT BY LEVEL <= 115), grid AS (SELECT i.Part_Code, m.Year_Month, m.Year_Month_Date FROM items i CROSS JOIN months m), purchase_monthly AS (SELECT TRIM(F_品目番号) AS Part_Code, F_勘定年月 AS Year_Month, TO_DATE(F_勘定年月,'YYYY/MM') AS Year_Month_Date, SUM(F_仕入数) AS Purchase_Qty, SUM(F_金額) AS Purchase_Amount, CASE WHEN SUM(F_仕入数)<>0 THEN SUM(F_金額)/SUM(F_仕入数) END AS Month_Unit_Price, MAX(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS Month_Max_Unit_Price, MIN(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS Month_Min_Unit_Price, AVG(CASE WHEN F_仕入数<>0 THEN F_金額/F_仕入数 END) AS Month_Simple_Avg_Unit_Price FROM PRONES.TB_仕入実績情報 GROUP BY TRIM(F_品目番号), F_勘定年月), windowed AS (SELECT g.Part_Code, g.Year_Month, CASE WHEN SUM(pm.Purchase_Qty) IS NOT NULL AND SUM(pm.Purchase_Qty)<>0 THEN SUM(pm.Purchase_Amount)/SUM(pm.Purchase_Qty) END AS Eff_Purchase_Unit_Price_6mo, MAX(pm.Month_Unit_Price) AS Window_Max_Unit_Price, MIN(pm.Month_Unit_Price) AS Window_Min_Unit_Price FROM grid g LEFT JOIN purchase_monthly pm ON pm.Part_Code = g.Part_Code AND pm.Year_Month_Date BETWEEN ADD_MONTHS(g.Year_Month_Date,-5) AND g.Year_Month_Date GROUP BY g.Part_Code, g.Year_Month), carried AS (SELECT g.Part_Code, g.Year_Month, LAST_VALUE(pm.Month_Unit_Price IGNORE NULLS) OVER (PARTITION BY g.Part_Code ORDER BY g.Year_Month_Date) AS Eff_Purchase_Unit_Price_Carry, LAST_VALUE(CASE WHEN pm.Month_Unit_Price IS NOT NULL THEN pm.Year_Month END IGNORE NULLS) OVER (PARTITION BY g.Part_Code ORDER BY g.Year_Month_Date) AS Carry_Purchase_Year_Month, LAST_VALUE(pm.Month_Max_Unit_Price IGNORE NULLS) OVER (PARTITION BY g.Part_Code ORDER BY g.Year_Month_Date) AS Carry_Max_Unit_Price, LAST_VALUE(pm.Month_Min_Unit_Price IGNORE NULLS) OVER (PARTITION BY g.Part_Code ORDER BY g.Year_Month_Date) AS Carry_Min_Unit_Price, LAST_VALUE(pm.Month_Simple_Avg_Unit_Price IGNORE NULLS) OVER (PARTITION BY g.Part_Code ORDER BY g.Year_Month_Date) AS Carry_Avg_Unit_Price FROM grid g LEFT JOIN purchase_monthly pm ON pm.Part_Code = g.Part_Code AND pm.Year_Month_Date = g.Year_Month_Date), purchase_by_supplier AS (SELECT TRIM(F_品目番号) AS Part_Code, F_勘定年月 AS Year_Month, TO_DATE(F_勘定年月,'YYYY/MM') AS Year_Month_Date, TRIM(F_指示先番号) AS Supplier_No, SUM(F_金額) AS Amount FROM PRONES.TB_仕入実績情報 GROUP BY TRIM(F_品目番号), F_勘定年月, TRIM(F_指示先番号)), supplier_name AS (SELECT TRIM(F_仕入先番号) AS Supplier_No, MAX(F_仕入先略称) AS Supplier_Name FROM PRONES.TB_仕入先情報 GROUP BY TRIM(F_仕入先番号)), windowed_sup AS (SELECT g.Part_Code, g.Year_Month, COUNT(DISTINCT pbs.Supplier_No) AS Cnt, MAX(pbs.Supplier_No) AS Single_Supplier FROM grid g LEFT JOIN purchase_by_supplier pbs ON pbs.Part_Code = g.Part_Code AND pbs.Year_Month_Date BETWEEN ADD_MONTHS(g.Year_Month_Date,-5) AND g.Year_Month_Date GROUP BY g.Part_Code, g.Year_Month), carried_sup AS (SELECT c.Part_Code, c.Year_Month, COUNT(DISTINCT pbs.Supplier_No) AS Cnt, MAX(pbs.Supplier_No) AS Single_Supplier FROM carried c LEFT JOIN purchase_by_supplier pbs ON pbs.Part_Code = c.Part_Code AND pbs.Year_Month = c.Carry_Purchase_Year_Month GROUP BY c.Part_Code, c.Year_Month), final_price AS (SELECT w.Part_Code, w.Year_Month, COALESCE(w.Eff_Purchase_Unit_Price_6mo, c.Eff_Purchase_Unit_Price_Carry) AS Eff_Purchase_Unit_Price, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN w.Year_Month ELSE c.Carry_Purchase_Year_Month END AS Purchase_Year_Month, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN w.Window_Max_Unit_Price ELSE c.Carry_Max_Unit_Price END AS Max_Unit_Price, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN w.Window_Min_Unit_Price ELSE c.Carry_Min_Unit_Price END AS Min_Unit_Price, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN w.Eff_Purchase_Unit_Price_6mo ELSE c.Carry_Avg_Unit_Price END AS Avg_Unit_Price, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN '6-Month Avg' WHEN c.Eff_Purchase_Unit_Price_Carry IS NOT NULL THEN 'Single Month' END AS Costing_Method, CASE WHEN w.Eff_Purchase_Unit_Price_6mo IS NOT NULL THEN CASE WHEN ws.Cnt = 1 THEN snw.Supplier_Name WHEN ws.Cnt > 1 THEN '*' END ELSE CASE WHEN cs.Cnt = 1 THEN snc.Supplier_Name WHEN cs.Cnt > 1 THEN '*' END END AS Supplier_Name_Src FROM windowed w JOIN carried c ON c.Part_Code = w.Part_Code AND c.Year_Month = w.Year_Month LEFT JOIN windowed_sup ws ON ws.Part_Code = w.Part_Code AND ws.Year_Month = w.Year_Month LEFT JOIN carried_sup cs ON cs.Part_Code = w.Part_Code AND cs.Year_Month = w.Year_Month LEFT JOIN supplier_name snw ON snw.Supplier_No = ws.Single_Supplier LEFT JOIN supplier_name snc ON snc.Supplier_No = cs.Single_Supplier), sale_days AS (SELECT DISTINCT TRIM(F_在庫品目番号) AS Part_Code, F_売上日 FROM PRONES.TB_売上実績新情報 WHERE F_売上日 >= '2023/07/01'), item_designated_supplier AS (SELECT TRIM(F_納入品目番号) AS Part_Code, MAX(TRIM(F_指示先番号)) AS Designated_Supplier FROM PRONES.TB_納入品目情報 GROUP BY TRIM(F_納入品目番号)), contract_price AS (SELECT TRIM(F_納入品目番号) AS Part_Code, TRIM(F_仕入先番号) AS Supplier, F_契約単価, CASE WHEN TRANSLATE(F_開始日,'0123456789','9999999999') = '9999/99/99' THEN TO_DATE(F_開始日,'YYYY/MM/DD') END AS Start_Date FROM PRONES.TB_納入品目仕入先単価情報 WHERE F_契約単価 > 0), contract_ranked AS (SELECT sd.Part_Code, sd.F_売上日, cp.F_契約単価, cp.Start_Date, ROW_NUMBER() OVER (PARTITION BY sd.Part_Code, sd.F_売上日 ORDER BY CASE WHEN cp.Supplier = ids.Designated_Supplier THEN 0 ELSE 1 END, cp.Start_Date DESC) AS rn FROM sale_days sd LEFT JOIN item_designated_supplier ids ON ids.Part_Code = sd.Part_Code JOIN contract_price cp ON cp.Part_Code = sd.Part_Code AND cp.Start_Date IS NOT NULL AND cp.Start_Date <= TO_DATE(sd.F_売上日,'YYYY/MM/DD')), contract_effective AS (SELECT Part_Code, F_売上日, F_契約単価 AS Contract_Unit_Price, Start_Date FROM contract_ranked WHERE rn = 1), primary_supplier AS (SELECT Part_Code, Supplier_No FROM (SELECT TRIM(F_品目番号) AS Part_Code, TRIM(F_指示先番号) AS Supplier_No, SUM(F_金額) AS Amount, ROW_NUMBER() OVER (PARTITION BY TRIM(F_品目番号) ORDER BY SUM(F_金額) DESC) AS rn FROM PRONES.TB_仕入実績情報 WHERE F_勘定年月 >= '2017/01' GROUP BY TRIM(F_品目番号), TRIM(F_指示先番号)) WHERE rn = 1) SELECT TRIM(s.F_得意先番号) AS Customer_No, MAX(TRIM(s.F_得意先番号) || (chr(35)) || TO_CHAR(ORA_HASH(TRIM(s.F_得意先番号)))) AS Customer_Key, TRIM(s.F_在庫品目番号) AS Part_Code, SUBSTR(s.F_売上日,1,7) AS Year_Month, TO_DATE(s.F_売上日,'YYYY/MM/DD') AS Sales_Date, SUM(s.F_数量) AS Qty, SUM(s.F_金額) AS Amount, MAX(fp.Eff_Purchase_Unit_Price) AS Purchase_Unit_Price, ROUND(SUM(s.F_数量) * MAX(fp.Eff_Purchase_Unit_Price)) AS Est_Actual_Cost, CASE WHEN MAX(fp.Eff_Purchase_Unit_Price) IS NOT NULL THEN 'Yes' ELSE 'No' END AS Purchase_Price_Found, MAX(fp.Purchase_Year_Month) AS Purchase_Year_Month, MAX(fp.Supplier_Name_Src) AS Supplier_Name, MAX(fp.Costing_Method) AS Costing_Method, MAX(fp.Max_Unit_Price) AS Max_Unit_Price, MAX(fp.Min_Unit_Price) AS Min_Unit_Price, MAX(fp.Avg_Unit_Price) AS Avg_Unit_Price, MAX(ce.Contract_Unit_Price) AS Contract_Unit_Price, MAX(ce.Start_Date) AS Contract_Price_Eff_Date, ROUND(SUM(s.F_数量) * MAX(ce.Contract_Unit_Price)) AS Est_Contract_Cost, CASE WHEN MAX(ce.Contract_Unit_Price) IS NOT NULL THEN 'Yes' ELSE 'No' END AS Contract_Price_Found, CASE WHEN MAX(ps.Supplier_No) IS NULL THEN 'No Purchase Record' WHEN MAX(ps.Supplier_No) IN ('2000001','2000002','2000004','2000005','2000006','2000007') THEN 'BEI' ELSE 'Other' END AS Supplier_Category, CASE WHEN MAX(ce.Contract_Unit_Price) IS NOT NULL THEN ROUND(SUM(s.F_数量) * MAX(ce.Contract_Unit_Price)) ELSE ROUND(SUM(s.F_金額) * 0.85) END AS Est_Approx_Cost, CASE WHEN MAX(ce.Contract_Unit_Price) IS NOT NULL THEN 'Contract Price' ELSE 'Sales x 85%' END AS Approx_Cost_Method, MAX(s.F_登録日) AS Last_Updated FROM PRONES.TB_売上実績新情報 s LEFT JOIN final_price fp ON fp.Part_Code = TRIM(s.F_在庫品目番号) AND fp.Year_Month = SUBSTR(s.F_売上日,1,7) LEFT JOIN contract_effective ce ON ce.Part_Code = TRIM(s.F_在庫品目番号) AND ce.F_売上日 = s.F_売上日 LEFT JOIN primary_supplier ps ON ps.Part_Code = TRIM(s.F_在庫品目番号) WHERE s.F_売上日 >= '2023/07/01' GROUP BY TRIM(s.F_得意先番号), TRIM(s.F_在庫品目番号), s.F_売上日 ) q"),
				    Source = Table.TransformColumnTypes(Raw, {{"PURCHASE_PRICE_FOUND", type text}, {"SALES_DATE", type date}, {"QTY", type number}, {"AMOUNT", type number}, {"PURCHASE_UNIT_PRICE", type number}, {"EST_ACTUAL_COST", type number}, {"PURCHASE_YEAR_MONTH", type text}, {"SUPPLIER_NAME", type text}, {"COSTING_METHOD", type text}, {"MAX_UNIT_PRICE", type number}, {"MIN_UNIT_PRICE", type number}, {"AVG_UNIT_PRICE", type number}, {"CONTRACT_UNIT_PRICE", type number}, {"CONTRACT_PRICE_EFF_DATE", type date}, {"EST_CONTRACT_COST", type number}, {"CONTRACT_PRICE_FOUND", type text}, {"SUPPLIER_CATEGORY", type text}, {"EST_APPROX_COST", type number}, {"APPROX_COST_METHOD", type text}, {"LAST_UPDATED", type datetime}})
				in
				    Source

	annotation PBI_ResultType = Table

