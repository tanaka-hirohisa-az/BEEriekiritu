table Dim_Supplier
	lineageTag: 6db3f655-b851-4158-b6cc-f7a0877d661d

	column Supplier_No
		dataType: string
		lineageTag: 827e9e9d-fb7b-4d37-a662-5dba09146521
		summarizeBy: none
		sourceColumn: SUPPLIER_NO

		annotation SummarizationSetBy = Automatic

	column Supplier_Name
		dataType: string
		lineageTag: 860e70d4-c2a1-400f-ac3a-6a1d41aa5ef1
		summarizeBy: none
		sourceColumn: SUPPLIER_NAME

		annotation SummarizationSetBy = Automatic

	partition Dim_Supplier = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"), "SELECT TRIM(F_仕入先番号) AS Supplier_No, MAX(F_仕入先名称) AS Supplier_Name FROM PRONES.TB_仕入先情報 GROUP BY TRIM(F_仕入先番号)")
				in
				    Source

	annotation PBI_ResultType = Table

