table Fact_受注見込
	lineageTag: 28c24dea-c28c-5a89-8c4c-990df4fadce9

	measure 確定金額 = CALCULATE(SUM('Fact_受注見込'[金額]), 'Fact_受注見込'[区分種別] = "確定")
		formatString: #,##0
		lineageTag: d147cfbb-2cfe-5ffe-9cd1-d7958d9ac412

	measure 内示金額 = CALCULATE(SUM('Fact_受注見込'[金額]), 'Fact_受注見込'[区分種別] = "内示")
		formatString: #,##0
		lineageTag: 2b29fadd-8dbd-5eb8-8947-649c903e450f

	measure 内示＋確定 = [確定金額] + [内示金額]
		formatString: #,##0
		lineageTag: 52b92ab7-c39e-5b5e-a862-b7efe00b7514

	measure 予算額 = SUM('Fact_予算'[予算金額])
		formatString: #,##0
		lineageTag: 93c3d141-d27d-55f7-9c09-6f029fe7fb68

	measure 達成率 = DIVIDE([内示＋確定], [予算額])
		formatString: 0.0%
		lineageTag: 9d5e9403-9213-5662-8235-9ac388ba471b

	measure 予算差額 = [内示＋確定] - [予算額]
		formatString: #,##0
		lineageTag: 780f1d8b-66b0-578e-9715-8576c8481856

	measure 確定数量 = CALCULATE(SUM('Fact_受注見込'[数量]), 'Fact_受注見込'[区分種別] = "確定")
		formatString: #,##0
		lineageTag: c329c5e6-f42f-5c75-9942-8b0f4a7e7648

	measure 内示数量 = CALCULATE(SUM('Fact_受注見込'[数量]), 'Fact_受注見込'[区分種別] = "内示")
		formatString: #,##0
		lineageTag: ecca3193-d54d-5c15-86b5-42460bc2f690

	measure データ基準日 = FORMAT(MAX('Fact_受注見込'[基準日]), "yyyy/mm/dd")
		lineageTag: 2dea6055-b911-5bf8-aaf4-232e6a884c92

	measure 見込金額 = CALCULATE(SUM('Fact_受注見込'[金額]), 'Fact_受注見込'[区分種別] = "見込")
		formatString: #,##0
		lineageTag: c4965344-33a6-53b5-8385-6d8256d3b63e

	measure 内示＋確定＋見込 = [内示＋確定] + [見込金額]
		formatString: #,##0
		lineageTag: b8e90e8e-9003-5f2c-89c1-082780bd95cc

	measure 達成率_見込含む = DIVIDE([内示＋確定＋見込], [予算額])
		formatString: 0.0%
		lineageTag: 7e485752-1df2-5931-bd2f-e0b213874fda

