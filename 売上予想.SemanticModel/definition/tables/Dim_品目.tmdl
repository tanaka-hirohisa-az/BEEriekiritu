	partition Dim_品目 = m
		mode: import
		source =
				let
				    Source = Value.NativeQuery(Oracle.Database("(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=banshu-srv)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=prones)))"), "SELECT * FROM ( SELECT UPPER(TRIM(TO_SINGLE_BYTE(TRANSLATE(F_納入品目番号, 'A'||CHR(9)||CHR(10)||CHR(13), 'A')))) AS 品目コード, MAX(TRIM(F_納入品目番号)) AS 品目コード原文, MAX(TRIM(F_品目名称)) AS 品目名称, MAX(TRIM(F_形式)) AS 形式, MAX(TRIM(F_品目区分)) AS 品目区分, MAX(TRIM(F_指示先番号)) AS 指示先番号 FROM PRONES.TB_納入品目情報 WHERE UPPER(TRIM(TO_SINGLE_BYTE(TRANSLATE(F_納入品目番号, 'A'||CHR(9)||CHR(10)||CHR(13), 'A')))) IS NOT NULL GROUP BY UPPER(TRIM(TO_SINGLE_BYTE(TRANSLATE(F_納入品目番号, 'A'||CHR(9)||CHR(10)||CHR(13), 'A')))) ) q")
				in
				    Source

	annotation PBI_ResultType = Table
